# ---- Domain ----
DOMAIN_NAME=Company Policy Assistant

# ---- LLM ----
LLM_PROVIDER=nvidia          # modal | openai | anthropic
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2500
LLM_TEMPERATURE=0.2

# ---- Hugging Face & Modal Configuration ----
HF_TOKEN=hf_YOUR_NEW_TOKEN_HERE
HF_MODEL=openai/gpt-oss-20b
HF_BASE_URL=https://router.huggingface.co/v1
MODAL_APP_NAME=domain-specific-rag-llm
MODAL_LLM_URL=

# ---- Embeddings (NVIDIA NIM) ----
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nemotron-3-embed-1b
NVIDIA_API_KEY=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
NVIDIA_MODEL=nemotron-3-embed-1b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_DIM=2048

# ---- Vector DB ----
VECTOR_PROVIDER=qdrant       # qdrant | pinecone
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents
PINECONE_API_KEY=
PINECONE_INDEX=rag-documents

# ---- Chunking / retrieval ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
RETRIEVAL_CANDIDATES=12
MIN_SIMILARITY=0.10
SUFFICIENCY_THRESHOLD=0.15
MAX_CONTEXT_CHARS=16000

# ---- Versioning ----
PROMPT_VERSION=prompt_v001
DATASET_VERSION=golden_dataset_v001

# ---- Pricing (per 1M tokens, USD). Leave 0 if unknown; costs are never fabricated. ----
LLM_INPUT_COST_PER_1M_TOKENS=0
LLM_OUTPUT_COST_PER_1M_TOKENS=0
EMBEDDING_COST_PER_1M_TOKENS=0

# ---- Uploads ----
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx,.png,.jpg,.jpeg,.webp,.bmp,.tiff
DOCUMENTS_DIR=data/documents

# ---- Frontend ----
API_URL=http://localhost:8000
